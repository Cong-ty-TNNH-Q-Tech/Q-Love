# Q-Love Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=qlove
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=qlove
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ADMIN_SECRET=your_admin_jwt_secret_here_min_32_chars

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=qlove-media
R2_PUBLIC_URL=https://media.qlove.com

# ESMS.vn (SMS OTP)
ESMS_API_KEY=your_api_key
ESMS_SECRET_KEY=your_secret_key
ESMS_BRAND_NAME=QLove

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key

# AI Services
OPENAI_API_KEY=your_openai_key

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_dsn

# Grafana
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password

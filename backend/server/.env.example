# Server
PORT=3000
APP_ENV=development

# Database (REQUIRED)
DATABASE_DSN=host=localhost user=postgres password=CHANGEME dbname=qlove port=5432 sslmode=disable

# JWT (REQUIRED)
JWT_SECRET=CHANGEME_min_32_chars

# Redis (REQUIRED)

+func (r *matchRepository) ResetStreakForInactiveMatches(ctx context.Context, inactiveDuration time.Duration) error {
+	cutoffTime := time.Now().Add(-inactiveDuration)
+	return GetDB(ctx, r.db).
+		Model(&models.Match{}).
